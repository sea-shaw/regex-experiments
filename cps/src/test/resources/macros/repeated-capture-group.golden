{
  final class $anon() extends Regex[Tidy[Tuple1[List[Tidy[Tuple1[String]]]]]] {
    override def unapply(s: String): Option[Tidy[Tuple1[List[Tidy[Tuple1[String]]]]]] = {
      @tailrec def loop(pos: Int, acc: [A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[String]]]): Option[Tidy[Tuple1[List[Tidy[Tuple1[String]]]]]] = if (pos.<(s.length()).&&(s.charAt(pos).==('a'))) Some.apply[Tuple2[TidyNonEmpty[Tuple1[String]], Int]](Tuple2.apply[TidyNonEmpty[Tuple1[String]], Int](s.substring(pos, pos.+(1)), pos.+(1))) else None match {
        case None =>
          continue(pos, acc)
        case Some(res, newPos) =>
          if (newPos.==(pos)) continue(pos, acc) else loop(newPos, acc.::[Tidy[Tuple1[String]]](res))
      }
      def continue(`pos₂`: Int, `acc₂`: [A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[String]]]): Option[Tidy[Tuple1[List[Tidy[Tuple1[String]]]]]] = if (`pos₂`.==(s.length())) Some.apply[TidyNonEmpty[Tuple1[List[Tidy[Tuple1[String]]]]]](`acc₂`.reverse) else None
      loop(0, Nil)
    }
  }

  (new $anon(): Regex[Tidy[Tuple1[List[Tidy[Tuple1[String]]]]]])
}