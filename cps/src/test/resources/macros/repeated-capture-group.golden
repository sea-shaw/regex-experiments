{
  final class $anon() extends Regex[Tidy[Tuple1[List[Tidy[Tuple1[String]]]]]] {
    override def unapply(s: String): Option[Tidy[Tuple1[List[Tidy[Tuple1[String]]]]]] = {
      @tailrec def loop(pos: Int, acc: [A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[String]]]): WithPos[[A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[String]]]] = {
        val withPos: WithPos[Option[Tidy[Tuple1[String]]]] = if (pos.<(s.length()).&&(s.charAt(pos).==('a'))) WithPos.apply[Option[Tidy[Tuple1[String]]]](Some.apply[TidyNonEmpty[Tuple1[String]]](s.substring(pos, pos.+(1))).$asInstanceOf$[Option[Tidy[Tuple1[String]]]], pos.+(1)).$asInstanceOf$[WithPos[Option[TidyNonEmpty[Tuple1[String]]]]] else WithPos.apply[Option[Tidy[Tuple1[String]]]](None, -1)
        withPos.res match {
          case None =>
            WithPos.apply[List[Tidy[Tuple1[String]]]](acc.reverse, pos)
          case Some(res) =>
            if (withPos.pos.==(pos)) WithPos.apply[List[Tidy[Tuple1[String]]]](acc.reverse, pos) else loop(withPos.pos, acc.::[Tidy[Tuple1[String]]](res))
        }
      }
      val `res₂`: WithPos[List[Tidy[Tuple1[String]]]] = loop(0, Nil)
      if (`res₂`.pos.>=(0)) if (`res₂`.pos.==(s.length())) Some.apply[TidyNonEmpty[Tuple1[List[Tidy[Tuple1[String]]]]]](`res₂`.res) else None else None
    }
  }

  (new $anon(): Regex[Tidy[Tuple1[List[Tidy[Tuple1[String]]]]]])
}