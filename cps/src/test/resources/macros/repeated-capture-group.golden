{
  final class $anon() extends Regex[Tidy[Tuple1[List[String]]]] {
    override def unapply(s: String): Option[Tidy[Tuple1[List[String]]]] = {
      @tailrec def loop(pos: Int, elems: [A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[String]]], acc: [A >: Nothing <: Any] =>> List[A][WithPos[[A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[String]]]]]): Option[List[String]] = {
        val withPos: WithPos[Option[String]] = if (pos.<(s.length()).&&(s.charAt(pos).==('a'))) WithPos.apply[Option[String]](Some.apply[String](s.substring(pos, pos.+(1))), pos.+(1)) else WithPos.apply[Option[String]](None, -1)
        withPos.res match {
          case None =>
            backtrack(acc)
          case Some(elem) =>
            if (withPos.pos.==(pos)) backtrack(acc) else {
              val newElems: List[String] = elems.::[String](elem)
              loop(withPos.pos, newElems, acc.::[WithPos[List[String]]](WithPos.apply[List[String]](newElems, withPos.pos)))
            }
        }
      }
      @tailrec def backtrack(`acc₂`: [A >: Nothing <: Any] =>> List[A][WithPos[[A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[String]]]]]): Option[List[String]] = `acc₂` match {
        case Nil =>
          continue(0, Nil)
        case ::(WithPos(list, pos), tail) =>
          val res: Option[List[String]] = continue(`pos₂`, list)
          if (res.isDefined) res else backtrack(tail)
      }
      def continue(`pos₃`: Int, `list₂`: [A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[String]]]): Option[List[String]] = if (`pos₃`.==(s.length())) Some.apply[List[String]](`list₂`) else None
      loop(0, Nil, Nil)
    }
  }

  (new $anon(): Regex[List[String]])
}