{
  final class $anon() extends Regex[Tidy[Tuple1[List[String]]]] {
    override def unapply(s: String): Option[Tidy[Tuple1[List[String]]]] = {
      @tailrec def loop(pos: Int, elems: [A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[String]]], acc: [A >: Nothing <: Any] =>> List[A][WithPos[[A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[String]]]]]): Option[List[String]] = if (pos.<(s.length()).&&(s.charAt(pos).==('a'))) if (pos.+(1).>(pos)) Some.apply[WithPos[String]](WithPos.apply[String](s.substring(pos, pos.+(1)), pos.+(1))) else None else None match {
        case None =>
          backtrack(acc)
        case Some(WithPos(elem, newPos)) =>
          val newElems: List[String] = elems.::[String](elem)
          loop(newPos, newElems, acc.::[WithPos[List[String]]](WithPos.apply[List[String]](newElems, newPos)))
      }
      @tailrec def backtrack(lists: [A >: Nothing <: Any] =>> List[A][WithPos[[A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[String]]]]]): Option[List[String]] = lists match {
        case Nil =>
          None
        case ::(WithPos(list, pos), tail) =>
          val res: Option[List[String]] = if (`pos₂`.==(s.length())) Some.apply[List[String]](list) else None
          if (res.isDefined) res else backtrack(tail)
      }
      loop(0, Nil, List.apply[WithPos[Nil]](WithPos.apply[Nil.type](Nil, 0)))
    }
  }

  (new $anon(): Regex[List[String]])
}