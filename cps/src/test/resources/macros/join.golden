{
  final class $anon() extends Regex[Tidy[*:[Either[Unit, Unit], EmptyTuple]]] {
    override def unapply(s: String): Option[Tidy[*:[Either[Unit, Unit], EmptyTuple]]] = {
      def join(pos: Int, res: TidyNonEmpty[Tuple1[Either[Unit, Unit]]]): Option[Either[Unit, Unit]] = if (pos.<(s.length()).&&(s.charAt(pos).==('c'))) if (pos.+(1).==(s.length())) Some.apply[Either[Unit, Unit]](res) else None else None
      if (0.<(s.length()).&&(s.charAt(0).==('a'))) join(1, Left.apply[Unit, Nothing](())) else None.orElse[Either[Unit, Unit]](if (0.<(s.length()).&&(s.charAt(0).==('b'))) join(1, Right.apply[Nothing, Unit](())) else None)
    }
  }

  (new $anon(): Regex[Either[Unit, Unit]])
}