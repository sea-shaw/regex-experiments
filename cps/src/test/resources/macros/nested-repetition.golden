        val withPos: WithPos[Option[Tidy[Tuple2[String, TidyNonEmpty[*:[TidyNonEmpty[Tuple1[List[Tidy[Tuple1[String]]]]], EmptyTuple]]]]]] = if (pos.<(s.length()).&&(s.charAt(pos).==('a'))) {
          @tailrec def `loop₂`(`pos₂`: Int, `acc₂`: [A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[String]]]): WithPos[[A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[String]]]] = {
            val `withPos₂`: WithPos[Option[Tidy[Tuple1[String]]]] = if (`pos₂`.<(s.length()).&&(s.charAt(`pos₂`).==('b'))) WithPos.apply[Option[Tidy[Tuple1[String]]]](Some.apply[TidyNonEmpty[Tuple1[String]]](s.substring(`pos₂`, `pos₂`.+(1))).$asInstanceOf$[Option[Tidy[Tuple1[String]]]], `pos₂`.+(1)).$asInstanceOf$[WithPos[Option[TidyNonEmpty[Tuple1[String]]]]] else WithPos.apply[Option[Tidy[Tuple1[String]]]](None, -1)
            `withPos₂`.res match {
