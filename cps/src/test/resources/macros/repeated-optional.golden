{
  final class $anon() extends Regex[Tidy[Tuple1[List[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]]]] {
    override def unapply(s: String): Option[Tidy[Tuple1[List[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]]]] = {
      @tailrec def loop(pos: Int, acc: [A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]): [R >: Nothing <: Tuple] =>> Option[Tidy[R]][Tuple1[List[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]]] = {
        val withPos: WithPos[Tuple1[Option[Tidy[EmptyTuple]]]] = {
          def join(`pos₂`: Int, res: TidyNonEmpty[Tuple1[Option[Tidy[EmptyTuple]]]]): WithPos[Tuple1[Option[Tidy[EmptyTuple]]]] = WithPos.apply[Tuple1[Option[Tidy[EmptyTuple]]]](Some.apply[TidyNonEmpty[Tuple1[Option[Tidy[EmptyTuple]]]]](res).$asInstanceOf$[Option[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]], `pos₂`)
          val leftRes: WithPos[Tuple1[Option[Tidy[EmptyTuple]]]] = if (pos.<(s.length()).&&(s.charAt(pos).==('a'))) join(pos.+(1), Some.apply[Tidy[EmptyTuple]](())) else WithPos.apply[Tuple1[Option[Tidy[EmptyTuple]]]](None, -1)
          if (leftRes.res.isDefined) leftRes else join(pos, None)
        }
        withPos.res match {
          case None =>
            continue(pos, acc)
          case Some(res) =>
            if (withPos.pos.==(pos)) continue(pos, acc) else loop(withPos.pos, acc.::[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]](`res₂`))
        }
      }
      def continue(`pos₃`: Int, `acc₂`: [A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]): [R >: Nothing <: Tuple] =>> Option[Tidy[R]][Tuple1[List[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]]] = if (`pos₃`.==(s.length())) Some.apply[TidyNonEmpty[Tuple1[List[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]]]](`acc₂`.reverse) else None
      loop(0, Nil)
    }
  }

  (new $anon(): Regex[Tidy[Tuple1[List[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]]]])
}