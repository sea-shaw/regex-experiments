{
  final class $anon() extends Regex[Tidy[Tuple1[List[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]]]] {
    override def unapply(s: String): Option[Tidy[Tuple1[List[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]]]] = {
      @tailrec def loop(pos: Int, acc: [A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]): WithPos[[A >: Nothing <: Any] =>> List[A][Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]] = {
        val withPos: WithPos[Option[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]] = {
          val leftRes: WithPos[Option[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]] = if (pos.<(s.length()).&&(s.charAt(pos).==('a'))) WithPos.apply[Option[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]](Some.apply[TidyNonEmpty[Tuple1[Option[Tidy[EmptyTuple]]]]](Some.apply[Tidy[EmptyTuple]](())).$asInstanceOf$[Option[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]], pos.+(1)).$asInstanceOf$[WithPos[Option[TidyNonEmpty[Tuple1[Option[Tidy[EmptyTuple]]]]]]] else WithPos.apply[Option[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]](None, -1)
          if (leftRes.res.isDefined) leftRes else WithPos.apply[Option[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]](Some.apply[TidyNonEmpty[Tuple1[Option[Tidy[EmptyTuple]]]]](None).$asInstanceOf$[Option[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]], pos).$asInstanceOf$[WithPos[Option[TidyNonEmpty[Tuple1[Option[Tidy[EmptyTuple]]]]]]]
        }
        withPos.res match {
          case None =>
            WithPos.apply[List[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]](acc.reverse, pos)
          case Some(res) =>
            if (withPos.pos.==(pos)) WithPos.apply[List[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]](acc.reverse, pos) else loop(withPos.pos, acc.::[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]](res))
        }
      }
      val `res₂`: WithPos[List[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]] = loop(0, Nil)
      if (`res₂`.pos.>=(0)) if (`res₂`.pos.==(s.length())) Some.apply[TidyNonEmpty[Tuple1[List[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]]]](`res₂`.res) else None else None
    }
  }

  (new $anon(): Regex[Tidy[Tuple1[List[Tidy[Tuple1[Option[Tidy[EmptyTuple]]]]]]]])
}