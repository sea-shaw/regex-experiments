{
  final class $anon() extends Regex[Tidy[*:[List[Unit], EmptyTuple]]] {
    override def unapply(s: String): Option[Tidy[*:[List[Unit], EmptyTuple]]] = {
      @tailrec def loop(pos: Int, elems: [A >: Nothing <: Any] =>> List[A][Tidy[EmptyTuple.type]], acc: [A >: Nothing <: Any] =>> List[A][WithPos[[A >: Nothing <: Any] =>> List[A][Tidy[EmptyTuple.type]]]]): Option[List[Unit]] = {
        val withPos: WithPos[Option[Unit]] = if (pos.<(s.length()).&&(s.charAt(pos).==('a'))) WithPos.apply[Some[Unit]](Some.apply[Unit](()), pos.+(1)) else WithPos.apply[None.type](None, -1)
        withPos.res match {
          case None =>
            backtrack(acc)
          case Some(elem) =>
            if (withPos.pos.==(pos)) backtrack(acc) else {
              val newElems: List[Unit] = elems.::[Unit](elem)
              loop(withPos.pos, newElems, acc.::[WithPos[List[Unit]]](WithPos.apply[List[Unit]](newElems, withPos.pos)))
            }
        }
      }
      @tailrec def backtrack(lists: [A >: Nothing <: Any] =>> List[A][WithPos[[A >: Nothing <: Any] =>> List[A][Tidy[EmptyTuple.type]]]]): Option[List[Unit]] = lists match {
        case Nil =>
          None
        case ::(WithPos(list, pos), tail) =>
          if (`pos₂`.<(s.length()).&&(s.charAt(`pos₂`).==('a'))) if (`pos₂`.+(1).==(s.length())) Some.apply[List[Unit]](list) else backtrack(tail) else backtrack(tail)
      }
      loop(0, Nil, List.apply[WithPos[Nil]](WithPos.apply[Nil.type](Nil, 0)))
    }
  }

  (new $anon(): Regex[List[Unit]])
}