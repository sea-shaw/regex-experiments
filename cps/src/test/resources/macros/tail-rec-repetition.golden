{
  final class $anon() extends Regex[Tidy[*:[List[Unit], EmptyTuple]]] {
    override def unapply(s: String): Option[Tidy[*:[List[Unit], EmptyTuple]]] = {
      @tailrec def loop(pos: Int, elems: [A >: Nothing <: Any] =>> List[A][Tidy[EmptyTuple.type]], acc: [A >: Nothing <: Any] =>> List[A][WithPos[[A >: Nothing <: Any] =>> List[A][Tidy[EmptyTuple.type]]]]): Option[List[Unit]] = if (pos.<(s.length()).&&(s.charAt(pos).==('a'))) Some.apply[WithPos[Unit]](WithPos.apply[Unit]((), pos.+(1))) else None match {
        case None =>
          backtrack(acc)
        case Some(WithPos(elem, newPos)) =>
          if (newPos.==(pos)) backtrack(acc) else {
            val newElems: List[Unit] = elems.::[Unit](elem)
            loop(newPos, newElems, acc.::[WithPos[List[Unit]]](WithPos.apply[List[Unit]](newElems, newPos)))
          }
      }
      @tailrec def backtrack(lists: [A >: Nothing <: Any] =>> List[A][WithPos[[A >: Nothing <: Any] =>> List[A][Tidy[EmptyTuple.type]]]]): Option[List[Unit]] = lists match {
        case Nil =>
          None
        case ::(WithPos(list, pos), tail) =>
          val res: Option[List[Unit]] = if (`pos₂`.<(s.length()).&&(s.charAt(`pos₂`).==('a'))) if (`pos₂`.+(1).==(s.length())) Some.apply[List[Unit]](list) else None else None
          if (res.isDefined) res else backtrack(tail)
      }
      loop(0, Nil, List.apply[WithPos[Nil]](WithPos.apply[Nil.type](Nil, 0)))
    }
  }

  (new $anon(): Regex[List[Unit]])
}