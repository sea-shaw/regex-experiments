{
  final class $anon() extends Regex[Tidy[Tuple1[Either[String, String]]]] {
    override def unapply(s: String): Option[Tidy[Tuple1[Either[String, String]]]] = {
      def join(pos: Int, res: TidyNonEmpty[Tuple1[Either[String, String]]]): Option[Either[String, String]] = if (pos.==(s.length())) Some.apply[Either[String, String]](res) else None
      if (0.<(s.length()).&&(s.charAt(0).==('a'))) join(1, Left.apply[String, Nothing](s.substring(0, 1))) else None.orElse[Either[String, String]](if (0.<(s.length()).&&(s.charAt(0).==('b'))) join(1, Right.apply[Nothing, String](s.substring(0, 1))) else None)
    }
  }

  (new $anon(): Regex[Either[String, String]])
}