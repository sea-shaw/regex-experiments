{
  final class $anon() extends Regex[Tidy[Tuple1[List[Tidy[EmptyTuple]]]]] {
    override def unapply(s: String): Option[Tidy[Tuple1[List[Tidy[EmptyTuple]]]]] = {
      def join(pos: Int, res: TidyNonEmpty[Tuple1[List[Tidy[EmptyTuple]]]]): Option[Tidy[Tuple1[List[Tidy[EmptyTuple]]]]] = if (pos.<(s.length()).&&(s.charAt(pos).==('a'))) join(pos.+(1), res.::[Unit](())) else None.orElse[Tidy[Tuple1[List[Tidy[EmptyTuple]]]]](if (pos.==(s.length())) Some.apply[TidyNonEmpty[Tuple1[List[Tidy[EmptyTuple]]]]](res) else None)
      join(0, Nil)
    }
  }

  (new $anon(): Regex[Tidy[Tuple1[List[Tidy[EmptyTuple]]]]])
}