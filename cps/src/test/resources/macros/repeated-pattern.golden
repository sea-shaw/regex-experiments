{
  final class $anon() extends Regex[Tidy[Tuple1[List[Unit]]]] {
    override def unapply(s: String): Option[Tidy[Tuple1[List[Unit]]]] = {
      @tailrec def loop(pos: Int, elems: [A >: Nothing <: Any] =>> List[A][Tidy[EmptyTuple.type]], acc: [A >: Nothing <: Any] =>> List[A][WithPos[[A >: Nothing <: Any] =>> List[A][Tidy[EmptyTuple.type]]]]): Option[List[Unit]] = {
        val withPos: WithPos[Option[Unit]] = if (pos.<(s.length()).&&(s.charAt(pos).==('a'))) WithPos.apply[Option[Unit]](Some.apply[Unit](()).$asInstanceOf$[Option[Unit]], pos.+(1)).$asInstanceOf$[WithPos[Option[Unit]]] else WithPos.apply[Option[Unit]](None, -1)
        withPos.res match {
          case None =>
            backtrack(acc)
          case Some(elem) =>
            if (withPos.pos.==(pos)) backtrack(acc) else {
              val newElems: List[Unit] = elems.::[Unit](elem)
              loop(withPos.pos, newElems, acc.::[WithPos[List[Unit]]](WithPos.apply[List[Unit]](newElems, withPos.pos)))
            }
        }
      }
      @tailrec def backtrack(`acc₂`: [A >: Nothing <: Any] =>> List[A][WithPos[[A >: Nothing <: Any] =>> List[A][Tidy[EmptyTuple.type]]]]): Option[List[Unit]] = `acc₂` match {
        case Nil =>
          continue(0, Nil)
        case ::(WithPos(list, pos), tail) =>
          val res: Option[List[Unit]] = continue(`pos₂`, list)
          if (res.isDefined) res else backtrack(tail)
      }
      def continue(`pos₃`: Int, `list₂`: [A >: Nothing <: Any] =>> List[A][Tidy[EmptyTuple.type]]): Option[List[Unit]] = if (`pos₃`.==(s.length())) Some.apply[List[Unit]](`list₂`) else None
      loop(0, Nil, Nil)
    }
  }

  (new $anon(): Regex[List[Unit]])
}