{
  final class $anon() extends Regex[Tidy[Tuple1[List[Tidy[EmptyTuple]]]]] {
    override def unapply(s: String): Option[Tidy[Tuple1[List[Tidy[EmptyTuple]]]]] = {
      @tailrec def loop(pos: Int, acc: [A >: Nothing <: Any] =>> List[A][Tidy[EmptyTuple.type]]): [R >: Nothing <: Tuple] =>> Option[Tidy[R]][Tuple1[List[Tidy[EmptyTuple]]]] = {
        val withPos: WithPos[EmptyTuple] = if (pos.<(s.length()).&&(s.charAt(pos).==('a'))) WithPos.apply[EmptyTuple.type](Some.apply[Unit](()).$asInstanceOf$[Option[Tidy[EmptyTuple]]], pos.+(1)) else WithPos.apply[EmptyTuple.type](None, -1)
        withPos.res match {
          case None =>
            continue(pos, acc)
          case Some(res) =>
            if (withPos.pos.==(pos)) continue(pos, acc) else loop(withPos.pos, acc.::[Tidy[EmptyTuple]](res))
        }
      }
      def continue(`pos₂`: Int, `acc₂`: [A >: Nothing <: Any] =>> List[A][Tidy[EmptyTuple.type]]): [R >: Nothing <: Tuple] =>> Option[Tidy[R]][Tuple1[List[Tidy[EmptyTuple]]]] = if (`pos₂`.==(s.length())) Some.apply[TidyNonEmpty[Tuple1[List[Tidy[EmptyTuple]]]]](`acc₂`.reverse) else None
      loop(0, Nil)
    }
  }

  (new $anon(): Regex[Tidy[Tuple1[List[Tidy[EmptyTuple]]]]])
}