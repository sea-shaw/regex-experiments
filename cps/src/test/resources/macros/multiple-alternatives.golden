{
  final class $anon() extends Regex[Tidy[*:[Either[String, String], *:[Either[String, String], *:[Either[String, String], EmptyTuple]]]]] {
    override def unapply(s: String): Option[Tidy[*:[Either[String, String], *:[Either[String, String], *:[Either[String, String], EmptyTuple]]]]] = {
      def join(pos: Int, res: TidyNonEmpty[Tuple1[Either[String, String]]]): Option[NonEmptyTuple & *:[Either[String, String], *:[Either[String, String], *:[Either[String, String], EmptyTuple]]]] = {
        def `join₂`(`pos₂`: Int, `res₂`: TidyNonEmpty[Tuple1[Either[String, String]]]): Option[NonEmptyTuple & *:[Either[String, String], *:[Either[String, String], *:[Either[String, String], EmptyTuple]]]] = {
          def `join₃`(`pos₃`: Int, `res₃`: TidyNonEmpty[Tuple1[Either[String, String]]]): Option[NonEmptyTuple & *:[Either[String, String], *:[Either[String, String], *:[Either[String, String], EmptyTuple]]]] = if (`pos₃`.==(s.length())) Some.apply[NonEmptyTuple & *:[Either[String, String], *:[Either[String, String], *:[Either[String, String], EmptyTuple]]]](Tuple3.apply[Either[String, String], Either[String, String], Either[String, String]](res, `res₂`, `res₃`)) else None
          if (`pos₂`.<(s.length()).&&(s.charAt(`pos₂`).==('e'))) `join₃`(`pos₂`.+(1), Left.apply[String, Nothing](s.substring(`pos₂`, `pos₂`.+(1)))) else None.orElse[NonEmptyTuple & *:[Either[String, String], *:[Either[String, String], *:[Either[String, String], EmptyTuple]]]](if (`pos₂`.<(s.length()).&&(s.charAt(`pos₂`).==('f'))) `join₃`(`pos₂`.+(1), Right.apply[Nothing, String](s.substring(`pos₂`, `pos₂`.+(1)))) else None)
        }
        if (pos.<(s.length()).&&(s.charAt(pos).==('c'))) `join₂`(pos.+(1), Left.apply[String, Nothing](s.substring(pos, pos.+(1)))) else None.orElse[NonEmptyTuple & *:[Either[String, String], *:[Either[String, String], *:[Either[String, String], EmptyTuple]]]](if (pos.<(s.length()).&&(s.charAt(pos).==('d'))) `join₂`(pos.+(1), Right.apply[Nothing, String](s.substring(pos, pos.+(1)))) else None)
      }
      if (0.<(s.length()).&&(s.charAt(0).==('a'))) join(1, Left.apply[String, Nothing](s.substring(0, 1))) else None.orElse[NonEmptyTuple & *:[Either[String, String], *:[Either[String, String], *:[Either[String, String], EmptyTuple]]]](if (0.<(s.length()).&&(s.charAt(0).==('b'))) join(1, Right.apply[Nothing, String](s.substring(0, 1))) else None)
    }
  }

  (new $anon(): Regex[NonEmptyTuple & *:[Either[String, String], *:[Either[String, String], *:[Either[String, String], EmptyTuple]]]])
