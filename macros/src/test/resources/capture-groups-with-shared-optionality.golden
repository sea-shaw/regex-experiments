{
  final class $anon() extends Regex[Option[Tuple2[String, String]]] {
    private[this] val pattern: Pattern = Pattern.compile("(?:(a)(b))?")
    override def unapply(s: String): Option[Option[Tuple2[String, String]]] = {
      val m: (Matcher)? = $anon.this.pattern.matcher(s)
      if (m.matches()) {
        val groups: Array[Option[(String)?]] = Array.tabulate[Option[(String)?]](m.groupCount())(((i: Int) => Option.apply[(String)?](m.group(i.+(1)))))(ClassTag.apply[Option[(String)?]](classOf[Option]))
        val hchain: HSingleton[Option[HAppend[HSingleton[String], HSingleton[String]]]] = {
          val opt: Option[Sanitised[HAppend[HSingleton[String], HSingleton[String]]]] = {
            val left: Option[Sanitised[HSingleton[String]]] = {
              val capture: Option[String] = groups.apply(0)
              if (capture.isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](capture.get), true)) else None
            }
            val right: Option[Sanitised[HSingleton[String]]] = {
              val `capture₂`: Option[String] = groups.apply(1)
              if (`capture₂`.isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`capture₂`.get), true)) else None
            }
            if (left.isDefined.&&(right.isDefined)) Some.apply[Sanitised[HAppend[HSingleton[String], HSingleton[String]]]](Sanitised.apply[HAppend[HSingleton[String], HSingleton[String]]](++[HSingleton[String]](left.get.captures)[HSingleton[String]](right.get.captures), left.get.any.||(right.get.any))) else None
          }
          HSingleton.apply[Option[HAppend[HSingleton[String], HSingleton[String]]]](if (opt.isDefined) Some.apply[HAppend[HSingleton[String], HSingleton[String]]](opt.get.captures) else None)
        }
        Some.apply[Option[Tuple2[String, String]]]({
          val `opt₂`: Option[HAppend[HSingleton[String], HSingleton[String]]] = hchain.value
          if (`opt₂`.isDefined) Some.apply[Tuple2[String, String]]({
            val node: HAppend[HSingleton[String], HSingleton[String]] = `opt₂`.get
            Tuple2.apply[String, String](node.left.value, node.right.value)
          }) else None
        })
      } else None
    }
  }

  (new $anon(): Regex[Option[Tuple2[String, String]]])
}