{
  final class $anon() extends Regex[Tuple3[String, String, String]] {
    private[this] val pattern: Pattern = Pattern.compile("(a(b(c)d)e)")
    override def unapply(s: String): Option[Tuple3[String, String, String]] = {
      val m: (Matcher)? = $anon.this.pattern.matcher(s)
      if (m.matches()) {
        val groups: Array[Option[(String)?]] = Array.tabulate[Option[(String)?]](m.groupCount())(((i: Int) => Option.apply[(String)?](m.group(i.+(1)))))(ClassTag.apply[Option[(String)?]](classOf[Option]))
        val sanitised: Option[Sanitised[HAppend[HSingleton[String], HAppend[HSingleton[String], HSingleton[String]]]]] = {
          val capture: Option[Sanitised[HSingleton[String]]] = {
            val `capture₂`: Option[String] = groups.apply(0)
            if (`capture₂`.isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`capture₂`.get), true)) else None
          }
          val inner: Option[Sanitised[HAppend[HSingleton[String], HSingleton[String]]]] = {
            val `capture₃`: Option[Sanitised[HSingleton[String]]] = {
              val `capture₄`: Option[String] = groups.apply(1)
              if (`capture₄`.isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`capture₄`.get), true)) else None
            }
            val `inner₂`: Option[Sanitised[HSingleton[String]]] = {
              val `capture₅`: Option[String] = groups.apply(2)
              if (`capture₅`.isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`capture₅`.get), true)) else None
            }
            if (`capture₃`.isDefined.&&(`inner₂`.isDefined)) Some.apply[Sanitised[HAppend[HSingleton[String], HSingleton[String]]]](Sanitised.apply[HAppend[HSingleton[String], HSingleton[String]]](++[HSingleton[String]](`capture₃`.get.captures)[HSingleton[String]](`inner₂`.get.captures), `capture₃`.get.any.||(`inner₂`.get.any))) else None
          }
          if (capture.isDefined.&&(inner.isDefined)) Some.apply[Sanitised[HAppend[HSingleton[String], HAppend[HSingleton[String], HSingleton[String]]]]](Sanitised.apply[HAppend[HSingleton[String], HAppend[HSingleton[String], HSingleton[String]]]](++[HSingleton[String]](capture.get.captures)[HAppend[HSingleton[String], HSingleton[String]]](inner.get.captures), capture.get.any.||(inner.get.any))) else None
        }
        if (sanitised.isDefined) Some.apply[Tuple3[String, String, String]]({
          val node: HAppend[HSingleton[String], HAppend[HSingleton[String], HSingleton[String]]] = sanitised.get.captures
          val `node₂`: HAppend[HSingleton[String], HSingleton[String]] = node.right
          Tuple3.apply[String, String, String](node.left.value, `node₂`.left.value, `node₂`.right.value)
        }) else None
      } else None
    }
  }

  (new $anon(): Regex[Tuple3[String, String, String]])
}