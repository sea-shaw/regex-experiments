          val `sanitised₄`: Option[Sanitised[HSingleton[String]]] = groups.apply(2).map[Sanitised[HSingleton[String]]](((`s₄`: String) => Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`s₄`), true)))
          SanitisedT.apply[HSingleton[String]](`sanitised₄`)
        })[HAppend[HSingleton[String], HSingleton[String]]](((inner: HSingleton[String]) => ++[HSingleton[String]](`capture₂`)[HSingleton[String]](inner))))))[HAppend[HSingleton[String], HAppend[HSingleton[String], HSingleton[String]]]](((`inner₂`: HAppend[HSingleton[String], HSingleton[String]]) => ++[HSingleton[String]](capture)[HAppend[HSingleton[String], HSingleton[String]]](`inner₂`)))))
        sanitised.value[HAppend[HSingleton[String], HAppend[HSingleton[String], HSingleton[String]]]](sanitised).map[Tuple3[String, String, String]](((x$1: Sanitised[HAppend[HSingleton[String], HAppend[HSingleton[String], HSingleton[String]]]]) => x$1 match {
