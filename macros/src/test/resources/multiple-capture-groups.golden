{
  final class $anon() extends Regex[Tuple3[String, String, String]] {
    private[this] val pattern: Pattern = Pattern.compile("(a)(b)(c)")
    override def unapply(s: String): Option[Tuple3[String, String, String]] = {
      val m: (Matcher)? = $anon.this.pattern.matcher(s)
      if (m.matches()) {
        val groups: Array[Option[(String)?]] = Array.tabulate[Option[(String)?]](m.groupCount())(((i: Int) => Option.apply[(String)?](m.group(i.+(1)))))(ClassTag.apply[Option[(String)?]](classOf[Option]))
        val sanitised: Option[Sanitised[HAppend[HAppend[HSingleton[String], HSingleton[String]], HSingleton[String]]]] = {
          val left: Option[Sanitised[HAppend[HSingleton[String], HSingleton[String]]]] = {
            val `left₂`: Option[Sanitised[HSingleton[String]]] = {
              val capture: Option[String] = groups.apply(0)
              if (capture.isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](capture.get), true)) else None
            }
            val right: Option[Sanitised[HSingleton[String]]] = {
              val `capture₂`: Option[String] = groups.apply(1)
              if (`capture₂`.isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`capture₂`.get), true)) else None
            }
            if (`left₂`.isDefined.&&(right.isDefined)) Some.apply[Sanitised[HAppend[HSingleton[String], HSingleton[String]]]](Sanitised.apply[HAppend[HSingleton[String], HSingleton[String]]](++[HSingleton[String]](`left₂`.get.captures)[HSingleton[String]](right.get.captures), `left₂`.get.any.||(right.get.any))) else None
          }
          val `right₂`: Option[Sanitised[HSingleton[String]]] = {
            val `capture₃`: Option[String] = groups.apply(2)
            if (`capture₃`.isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`capture₃`.get), true)) else None
          }
          if (left.isDefined.&&(`right₂`.isDefined)) Some.apply[Sanitised[HAppend[HAppend[HSingleton[String], HSingleton[String]], HSingleton[String]]]](Sanitised.apply[HAppend[HAppend[HSingleton[String], HSingleton[String]], HSingleton[String]]](++[HAppend[HSingleton[String], HSingleton[String]]](left.get.captures)[HSingleton[String]](`right₂`.get.captures), left.get.any.||(`right₂`.get.any))) else None
        }
        if (sanitised.isDefined) Some.apply[Tuple3[String, String, String]]({
          val node: HAppend[HAppend[HSingleton[String], HSingleton[String]], HSingleton[String]] = sanitised.get.captures
          val `node₂`: HAppend[HSingleton[String], HSingleton[String]] = node.left
          Tuple3.apply[String, String, String](`node₂`.left.value, `node₂`.right.value, node.right.value)
        }) else None
      } else None
    }
  }

  (new $anon(): Regex[Tuple3[String, String, String]])
}