{
  final class $anon() extends Regex[Option[Tuple2[String, Ior[String, String]]]] {
    private[this] val pattern: Pattern = Pattern.compile("((a)|(b))*")
    override def unapply(s: String): Option[Option[Tuple2[String, Ior[String, String]]]] = {
      val m: (Matcher)? = $anon.this.pattern.matcher(s)
      if (m.matches()) {
        val groups: Array[Option[(String)?]] = Array.tabulate[Option[(String)?]](m.groupCount())(((i: Int) => Option.apply[(String)?](m.group(i.+(1)))))(ClassTag.apply[Option[(String)?]](classOf[Option]))
        val hchain: HSingleton[Option[HAppend[HSingleton[String], HSingleton[AltRep[[_$ >: Nothing <: Any] =>> HSingleton[String], [_$ >: Nothing <: Any] =>> HSingleton[String], true, [A >: Nothing <: Any, B >: Nothing <: Any] =>> Ior[A, B]]]]]] = {
          val opt: Option[Sanitised[HAppend[HSingleton[String], HSingleton[AltRep[[_$ >: Nothing <: Any] =>> HSingleton[String], [_$ >: Nothing <: Any] =>> HSingleton[String], true, [A >: Nothing <: Any, B >: Nothing <: Any] =>> Ior[A, B]]]]]] = if (groups.apply(0).isDefined) Some.apply[Sanitised[HAppend[HSingleton[String], HSingleton[AltRep[[_$ >: Nothing <: Any] =>> HSingleton[String], [_$ >: Nothing <: Any] =>> HSingleton[String], true, [A >: Nothing <: Any, B >: Nothing <: Any] =>> Ior[A, B]]]]]](Sanitised.apply[HAppend[HSingleton[String], HSingleton[AltRep[[_$ >: Nothing <: Any] =>> HSingleton[String], [_$ >: Nothing <: Any] =>> HSingleton[String], true, [A >: Nothing <: Any, B >: Nothing <: Any] =>> Ior[A, B]]]]](++[HSingleton[String]](HSingleton.apply[String](groups.apply(0).get))[HSingleton[AltRep[[_$ >: Nothing <: Any] =>> HSingleton[String], [_$ >: Nothing <: Any] =>> HSingleton[String], true, [A >: Nothing <: Any, B >: Nothing <: Any] =>> Ior[A, B]]]]({
            val left: Option[Sanitised[HSingleton[String]]] = if (groups.apply(1).isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](groups.apply(1).get), true)) else None
            val right: Option[Sanitised[HSingleton[String]]] = if (groups.apply(2).isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](groups.apply(2).get), true)) else None
            if (left.isDefined.&&(right.isDefined)) Some.apply[Sanitised[HSingleton[Ior[HSingleton[String], HSingleton[String]]]]](Sanitised.apply[HSingleton[Ior[HSingleton[String], HSingleton[String]]]](HSingleton.apply[Ior[HSingleton[String], HSingleton[String]]](Ior.Both.apply[HSingleton[String], HSingleton[String]](left.get.captures, right.get.captures)), left.get.any.||(right.get.any))) else if (left.isDefined) Some.apply[Sanitised[HSingleton[Ior[HSingleton[String], Nothing]]]](Sanitised.apply[HSingleton[Ior[HSingleton[String], Nothing]]](HSingleton.apply[Ior[HSingleton[String], Nothing]](Ior.Left.apply[HSingleton[String]](left.get.captures)), left.get.any)) else if (right.isDefined) Some.apply[Sanitised[HSingleton[Ior[Nothing, HSingleton[String]]]]](Sanitised.apply[HSingleton[Ior[Nothing, HSingleton[String]]]](HSingleton.apply[Ior[Nothing, HSingleton[String]]](Ior.Right.apply[HSingleton[String]](right.get.captures)), right.get.any)) else None
          }.get.captures), true)) else None
          HSingleton.apply[Option[HAppend[HSingleton[String], HSingleton[AltRep[[_$ >: Nothing <: Any] =>> HSingleton[String], [_$ >: Nothing <: Any] =>> HSingleton[String], true, [A >: Nothing <: Any, B >: Nothing <: Any] =>> Ior[A, B]]]]]](if (opt.isDefined) Some.apply[HAppend[HSingleton[String], HSingleton[AltRep[[_$ >: Nothing <: Any] =>> HSingleton[String], [_$ >: Nothing <: Any] =>> HSingleton[String], true, [A >: Nothing <: Any, B >: Nothing <: Any] =>> Ior[A, B]]]]](opt.get.captures) else None)
        }
        Some.apply[Option[Tuple2[String, Ior[String, String]]]]({
          val `opt₂`: Option[HAppend[HSingleton[String], HSingleton[AltRep[[_$ >: Nothing <: Any] =>> HSingleton[String], [_$ >: Nothing <: Any] =>> HSingleton[String], true, [A >: Nothing <: Any, B >: Nothing <: Any] =>> Ior[A, B]]]]] = hchain.value
          if (`opt₂`.isDefined) Some.apply[Tuple2[String, Ior[String, String]]]({
            val node: HAppend[HSingleton[String], HSingleton[AltRep[[_$ >: Nothing <: Any] =>> HSingleton[String], [_$ >: Nothing <: Any] =>> HSingleton[String], true, [A >: Nothing <: Any, B >: Nothing <: Any] =>> Ior[A, B]]]] = `opt₂`.get
            Tuple2.apply[String, Ior[String, String]](node.left.value, node.right.value match {
              case Ior.Left(left) =>
                Ior.Left.apply[String](`left₂`.value)
              case Ior.Right(right) =>
                Ior.Right.apply[String](`right₂`.value)
              case Ior.Both(left, right) =>
                Ior.Both.apply[String, String](`left₃`.value, `right₃`.value)
            })
          }) else None
        })
      } else None
    }
  }

  (new $anon(): Regex[Option[Tuple2[String, Ior[String, String]]]])
}