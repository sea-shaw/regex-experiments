{
  final class $anon() extends Regex[Option[Tuple2[String, Option[String]]]] {
    private[this] val pattern: Pattern = Pattern.compile("(a(b)?)?")
    override def unapply(s: String): Option[Option[Tuple2[String, Option[String]]]] = {
      val m: (Matcher)? = $anon.this.pattern.matcher(s)
      if (m.matches()) {
        val groups: Array[Option[(String)?]] = Array.tabulate[Option[(String)?]](m.groupCount())(((i: Int) => Option.apply[(String)?](m.group(i.+(1)))))(ClassTag.apply[Option[(String)?]](classOf[Option]))
        val sanitised: Option[Sanitised[HSingleton[Option[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]]]] = {
          val caps: Option[Sanitised[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]] = {
            val capture: Option[Sanitised[HSingleton[String]]] = {
              val `capture₂`: Option[String] = groups.apply(0)
              if (`capture₂`.isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`capture₂`.get), true)) else None
            }
            val inner: Option[Sanitised[HSingleton[Option[HSingleton[String]]]]] = {
              val `caps₂`: Option[Sanitised[HSingleton[String]]] = {
                val `capture₃`: Option[String] = groups.apply(1)
                if (`capture₃`.isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`capture₃`.get), true)) else None
              }
              if (`caps₂`.isDefined) Some.apply[Sanitised[HSingleton[Some[HSingleton[String]]]]](Sanitised.apply[HSingleton[Some[HSingleton[String]]]](HSingleton.apply[Some[HSingleton[String]]](Some.apply[HSingleton[String]](`caps₂`.get.captures)), `caps₂`.get.any)) else Some.apply[Sanitised[HSingleton[None]]](Sanitised.apply[HSingleton[None]](HSingleton.apply[None.type](None), false))
            }
            if (capture.isDefined.&&(inner.isDefined)) Some.apply[Sanitised[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]](Sanitised.apply[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]](++[HSingleton[String]](capture.get.captures)[HSingleton[Option[HSingleton[String]]]](inner.get.captures), capture.get.any.||(inner.get.any))) else None
          }
          if (caps.isDefined) Some.apply[Sanitised[HSingleton[Some[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]]]](Sanitised.apply[HSingleton[Some[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]]](HSingleton.apply[Some[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]](Some.apply[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]](caps.get.captures)), caps.get.any)) else Some.apply[Sanitised[HSingleton[None]]](Sanitised.apply[HSingleton[None]](HSingleton.apply[None.type](None), false))
        }
        if (sanitised.isDefined) Some.apply[Option[Tuple2[String, Option[String]]]](sanitised.get.captures.value.map[Tuple2[String, Option[String]]](((node: HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]) => {
          val `node₂`: HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]] = node
          Tuple2.apply[String, Option[String]](`node₂`.left.value, `node₂`.right.value.map[String](((`node₃`: HSingleton[String]) => `node₃`.value)))
        }))) else None
      } else None
    }
  }

  (new $anon(): Regex[Option[Tuple2[String, Option[String]]]])
}