{
  final class $anon() extends Regex[Option[Tuple2[String, Option[String]]]] {
    private[this] val pattern: Pattern = Pattern.compile("(a(b)?)?")
    override def unapply(s: String): Option[Option[Tuple2[String, Option[String]]]] = {
      val m: (Matcher)? = $anon.this.pattern.matcher(s)
      if (m.matches()) {
        val groups: Array[Option[(String)?]] = Array.tabulate[Option[(String)?]](m.groupCount())(((i: Int) => Option.apply[(String)?](m.group(i.+(1)))))(ClassTag.apply[Option[(String)?]](classOf[Option]))
        val sanitised: SanitisedT[HSingleton[Option[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]]] = {
          val caps: SanitisedT[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]] = flatMap[HSingleton[String]]({
            val `sanitised₂`: Option[Sanitised[HSingleton[String]]] = groups.apply(0).map[Sanitised[HSingleton[String]]](((`s₂`: String) => Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`s₂`), true)))
            SanitisedT.apply[HSingleton[String]](`sanitised₂`)
          })[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]](((capture: HSingleton[String]) => map[HSingleton[Option[HSingleton[String]]]]({
            val `caps₂`: SanitisedT[HSingleton[String]] = {
              val `sanitised₃`: Option[Sanitised[HSingleton[String]]] = groups.apply(1).map[Sanitised[HSingleton[String]]](((`s₃`: String) => Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`s₃`), true)))
              SanitisedT.apply[HSingleton[String]](`sanitised₃`)
            }
            SanitisedT.apply[HSingleton[Option[HSingleton[String]]]](some[Sanitised[HSingleton[Option[HSingleton[String]]]]](sequence[HSingleton[String]](value[HSingleton[String]](`caps₂`)).map[HSingleton[Option[HSingleton[String]]]](((_$: Option[HSingleton[String]]) => singleton[Option[HSingleton[String]]](_$)))))
          })[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]](((inner: HSingleton[Option[HSingleton[String]]]) => ++[HSingleton[String]](capture)[HSingleton[Option[HSingleton[String]]]](inner)))))
          SanitisedT.apply[HSingleton[Option[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]]](some[Sanitised[HSingleton[Option[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]]]](sequence[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]](value[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]](caps)).map[HSingleton[Option[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]]](((`_$₂`: Option[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]) => singleton[Option[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]](`_$₂`)))))
        }
        sanitised.value[HSingleton[Option[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]]](sanitised).map[Option[Tuple2[String, Option[String]]]](((x$1: Sanitised[HSingleton[Option[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]]]) => x$1 match {
          case Sanitised(node, _) =>
            node.value.map[Tuple2[String, Option[String]]](((`node₂`: HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]) => {
              val `node₃`: HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]] = `node₂`
              Tuple2.apply[String, Option[String]](`node₃`.left.value, `node₃`.right.value.map[String](((`node₄`: HSingleton[String]) => `node₄`.value)))
            }))
        }))
      } else None
    }
  }

  (new $anon(): Regex[Option[Tuple2[String, Option[String]]]])
}