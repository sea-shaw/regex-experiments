{
  final class $anon() extends Regex[Option[Tuple2[String, Option[String]]]] {
    private[this] val pattern: Pattern = Pattern.compile("(a(b)?)?")
    override def unapply(s: String): Option[Option[Tuple2[String, Option[String]]]] = {
      val m: (Matcher)? = $anon.this.pattern.matcher(s)
      if (m.matches()) {
        val groups: Array[Option[(String)?]] = Array.tabulate[Option[(String)?]](m.groupCount())(((i: Int) => Option.apply[(String)?](m.group(i.+(1)))))(ClassTag.apply[Option[(String)?]](classOf[Option]))
        val hchain: HSingleton[Option[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]] = {
          val opt: Option[Sanitised[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]] = if (groups.apply(0).isDefined) Some.apply[Sanitised[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]](Sanitised.apply[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]](++[HSingleton[String]](HSingleton.apply[String](groups.apply(0).get))[HSingleton[Option[HSingleton[String]]]]({
            val `opt₂`: Option[Sanitised[HSingleton[String]]] = if (groups.apply(1).isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](groups.apply(1).get), true)) else None
            HSingleton.apply[Option[HSingleton[String]]](if (`opt₂`.isDefined) Some.apply[HSingleton[String]](`opt₂`.get.captures) else None)
          }), true)) else None
          HSingleton.apply[Option[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]]](if (opt.isDefined) Some.apply[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]](opt.get.captures) else None)
        }
        Some.apply[Option[Tuple2[String, Option[String]]]]({
          val `opt₃`: Option[HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]]] = hchain.value
          if (`opt₃`.isDefined) Some.apply[Tuple2[String, Option[String]]]({
            val node: HAppend[HSingleton[String], HSingleton[Option[HSingleton[String]]]] = `opt₃`.get
            Tuple2.apply[String, Option[String]](node.left.value, {
              val `opt₄`: Option[HSingleton[String]] = node.right.value
              if (`opt₄`.isDefined) Some.apply[String](`opt₄`.get.value) else None
            })
          }) else None
        })
      } else None
    }
  }

  (new $anon(): Regex[Option[Tuple2[String, Option[String]]]])
}