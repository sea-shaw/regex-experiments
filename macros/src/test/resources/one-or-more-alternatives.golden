{
  final class $anon() extends Regex[Tuple2[String, Ior[String, String]]] {
    private[this] val pattern: Pattern = Pattern.compile("((a)|(b))+")
    override def unapply(s: String): Option[Tuple2[String, Ior[String, String]]] = {
      val m: (Matcher)? = $anon.this.pattern.matcher(s)
      if (m.matches()) {
        val groups: Array[Option[(String)?]] = Array.tabulate[Option[(String)?]](m.groupCount())(((i: Int) => Option.apply[(String)?](m.group(i.+(1)))))(ClassTag.apply[Option[(String)?]](classOf[Option]))
        val sanitised: Option[Sanitised[HAppend[HSingleton[String], HSingleton[AltRep[[_$ >: Nothing <: Any] =>> HSingleton[String], [_$ >: Nothing <: Any] =>> HSingleton[String], true, [A >: Nothing <: Any, B >: Nothing <: Any] =>> Ior[A, B]]]]]] = {
          val capture: Option[Sanitised[HSingleton[String]]] = {
            val `capture₂`: Option[String] = groups.apply(0)
            if (`capture₂`.isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`capture₂`.get), true)) else None
          }
          val inner: Option[Sanitised[HSingleton[AltRep[[_$ >: Nothing <: Any] =>> HSingleton[String], [_$ >: Nothing <: Any] =>> HSingleton[String], true, [A >: Nothing <: Any, B >: Nothing <: Any] =>> Ior[A, B]]]]] = {
            val left: Option[Sanitised[HSingleton[String]]] = {
              val `capture₃`: Option[String] = groups.apply(1)
              if (`capture₃`.isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`capture₃`.get), true)) else None
            }
            val right: Option[Sanitised[HSingleton[String]]] = {
              val `capture₄`: Option[String] = groups.apply(2)
              if (`capture₄`.isDefined) Some.apply[Sanitised[HSingleton[String]]](Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`capture₄`.get), true)) else None
            }
            if (left.isDefined.&&(right.isDefined)) Some.apply[Sanitised[HSingleton[Ior[HSingleton[String], HSingleton[String]]]]](Sanitised.apply[HSingleton[Ior[HSingleton[String], HSingleton[String]]]](HSingleton.apply[Ior[HSingleton[String], HSingleton[String]]](Ior.Both.apply[HSingleton[String], HSingleton[String]](left.get.captures, right.get.captures)), left.get.any.||(right.get.any))) else if (left.isDefined) Some.apply[Sanitised[HSingleton[Ior[HSingleton[String], Nothing]]]](Sanitised.apply[HSingleton[Ior[HSingleton[String], Nothing]]](HSingleton.apply[Ior[HSingleton[String], Nothing]](Ior.Left.apply[HSingleton[String]](left.get.captures)), left.get.any)) else if (right.isDefined) Some.apply[Sanitised[HSingleton[Ior[Nothing, HSingleton[String]]]]](Sanitised.apply[HSingleton[Ior[Nothing, HSingleton[String]]]](HSingleton.apply[Ior[Nothing, HSingleton[String]]](Ior.Right.apply[HSingleton[String]](right.get.captures)), right.get.any)) else None
          }
          if (capture.isDefined.&&(inner.isDefined)) Some.apply[Sanitised[HAppend[HSingleton[String], HSingleton[AltRep[[_$ >: Nothing <: Any] =>> HSingleton[String], [_$ >: Nothing <: Any] =>> HSingleton[String], true, [A >: Nothing <: Any, B >: Nothing <: Any] =>> Ior[A, B]]]]]](Sanitised.apply[HAppend[HSingleton[String], HSingleton[AltRep[[_$ >: Nothing <: Any] =>> HSingleton[String], [_$ >: Nothing <: Any] =>> HSingleton[String], true, [A >: Nothing <: Any, B >: Nothing <: Any] =>> Ior[A, B]]]]](++[HSingleton[String]](capture.get.captures)[HSingleton[AltRep[[_$ >: Nothing <: Any] =>> HSingleton[String], [_$ >: Nothing <: Any] =>> HSingleton[String], true, [A >: Nothing <: Any, B >: Nothing <: Any] =>> Ior[A, B]]]](inner.get.captures), capture.get.any.||(inner.get.any))) else None
        }
        if (sanitised.isDefined) Some.apply[Tuple2[String, Ior[String, String]]]({
          val node: HAppend[HSingleton[String], HSingleton[AltRep[[_$ >: Nothing <: Any] =>> HSingleton[String], [_$ >: Nothing <: Any] =>> HSingleton[String], true, [A >: Nothing <: Any, B >: Nothing <: Any] =>> Ior[A, B]]]] = sanitised.get.captures
          Tuple2.apply[String, Ior[String, String]](node.left.value, node.right.value match {
            case Ior.Left(left) =>
              Ior.Left.apply[String](`left₂`.value)
            case Ior.Right(right) =>
              Ior.Right.apply[String](`right₂`.value)
            case Ior.Both(left, right) =>
              Ior.Both.apply[String, String](`left₃`.value, `right₃`.value)
          })
        }) else None
      } else None
    }
  }

  (new $anon(): Regex[Tuple2[String, Ior[String, String]]])
}