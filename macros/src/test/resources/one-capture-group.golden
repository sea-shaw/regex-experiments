{
  final class $anon() extends Regex[String] {
    private[this] val pattern: Pattern = Pattern.compile("(a)")
    override def unapply(s: String): Option[String] = {
      val m: (Matcher)? = $anon.this.pattern.matcher(s)
      if (m.matches()) {
        val groups: Array[Option[(String)?]] = Array.tabulate[Option[(String)?]](m.groupCount())(((i: Int) => Option.apply[(String)?](m.group(i.+(1)))))(ClassTag.apply[Option[(String)?]](classOf[Option]))
        val hchain: HSingleton[String] = HSingleton.apply[String](groups.apply(0).get)
        Some.apply[String](hchain.value)
      } else None
    }
  }

  (new $anon(): Regex[String])
}