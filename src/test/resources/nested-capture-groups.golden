{
  final class $anon() extends Regex[Tuple3[String, String, String]] {
    private[this] val pattern: Pattern = Pattern.compile("(a(b(c)d)e)")
    override def unapply(s: String): Option[Tuple3[String, String, String]] = {
      val m: (Matcher)? = $anon.this.pattern.matcher(s)
      if (m.matches()) {
        val groups: Array[Option[(String)?]] = Array.tabulate[Option[(String)?]](m.groupCount())(((i: Int) => Option.apply[(String)?](m.group(i.+(1)))))(ClassTag.apply[Option[(String)?]](classOf[Option]))
        val sanitised: SanitisedT[[A >: Nothing <: Any] =>> Option[A], HCons[String, HConcat[HConcat[HEmpty, HCons[String, HConcat[HConcat[HEmpty, HCons[String, HEmpty]], HEmpty]]], HEmpty]]] = toFlatMapOps[[A >: Nothing <: Any] =>> SanitisedT[Option, A], HSingleton[String]]({
          val `sanitised₂`: Option[Sanitised[HSingleton[String]]] = groups.apply(0).map[Sanitised[HSingleton[String]]](((`s₂`: String) => Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`s₂`), true)))
          SanitisedT.apply[Option, HSingleton[String]](`sanitised₂`)
        })(given_Monad_SanitisedT[Option](catsInstancesForOption)).flatMap[HAppend[HSingleton[String], HConcat[HConcat[HEmpty, HCons[String, HConcat[HConcat[HEmpty, HCons[String, HEmpty]], HEmpty]]], HEmpty]]](((capture: HSingleton[String]) => toFunctorOps[[A >: Nothing <: Any] =>> SanitisedT[[A >: Nothing <: Any] =>> Option[A], A], HConcat[HConcat[HEmpty, HCons[String, HConcat[HConcat[HEmpty, HCons[String, HEmpty]], HEmpty]]], HEmpty]](toFlatMapOps[[A >: Nothing <: Any] =>> SanitisedT[Option, A], HSingleton[String]]({
          val `sanitised₃`: Option[Sanitised[HSingleton[String]]] = groups.apply(1).map[Sanitised[HSingleton[String]]](((`s₃`: String) => Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`s₃`), true)))
          SanitisedT.apply[Option, HSingleton[String]](`sanitised₃`)
        })(given_Monad_SanitisedT[Option](catsInstancesForOption)).flatMap[HAppend[HSingleton[String], HConcat[HConcat[HEmpty, HCons[String, HEmpty]], HEmpty]]](((`capture₂`: HSingleton[String]) => toFunctorOps[[A >: Nothing <: Any] =>> SanitisedT[[A >: Nothing <: Any] =>> Option[A], A], HConcat[HConcat[HEmpty, HCons[String, HEmpty]], HEmpty]]({
          val `sanitised₄`: Option[Sanitised[HSingleton[String]]] = groups.apply(2).map[Sanitised[HSingleton[String]]](((`s₄`: String) => Sanitised.apply[HSingleton[String]](HSingleton.apply[String](`s₄`), true)))
          SanitisedT.apply[Option, HSingleton[String]](`sanitised₄`)
        })(given_Functor_SanitisedT[[A >: Nothing <: Any] =>> Option[A]](catsInstancesForOption)).map[HAppend[HSingleton[String], HConcat[HConcat[HEmpty, HCons[String, HEmpty]], HEmpty]]](((inner: HConcat[HConcat[HEmpty, HCons[String, HEmpty]], HEmpty]) => HAppend.apply[HSingleton[String], HConcat[HConcat[HEmpty, HCons[String, HEmpty]], HEmpty]](`capture₂`, inner))))))(given_Functor_SanitisedT[[A >: Nothing <: Any] =>> Option[A]](catsInstancesForOption)).map[HAppend[HSingleton[String], HConcat[HConcat[HEmpty, HCons[String, HConcat[HConcat[HEmpty, HCons[String, HEmpty]], HEmpty]]], HEmpty]]](((`inner₂`: HConcat[HConcat[HEmpty, HCons[String, HConcat[HConcat[HEmpty, HCons[String, HEmpty]], HEmpty]]], HEmpty]) => HAppend.apply[HSingleton[String], HConcat[HConcat[HEmpty, HCons[String, HConcat[HConcat[HEmpty, HCons[String, HEmpty]], HEmpty]]], HEmpty]](capture, `inner₂`)))))
        sanitised.value.map[Tuple3[String, String, String]](((x$1: Sanitised[HCons[String, HConcat[HConcat[HEmpty, HCons[String, HConcat[HConcat[HEmpty, HCons[String, HEmpty]], HEmpty]]], HEmpty]]]) => x$1 match {
          case Sanitised(captures, _) =>
            {
              val node: HAppend[HSingleton[String], HConcat[HConcat[HEmpty, HCons[String, HConcat[HConcat[HEmpty, HCons[String, HEmpty]], HEmpty]]], HEmpty]] = captures
              val `node₂`: HAppend[HSingleton[String], HConcat[HConcat[HEmpty, HCons[String, HEmpty]], HEmpty]] = node.right
              Tuple3.apply[String, String, String](node.left.value, `node₂`.left.value, `node₂`.right.value)
